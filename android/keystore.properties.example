# 签名配置模板。复制为 android/keystore.properties 后填入真实值。
#
#   cp android/keystore.properties.example android/keystore.properties
#
# keystore.properties 已在 .gitignore 中，不会进 Git —— 里面是明文密码，
# 务必只保留在本机与密码管理器中。

# .jks 文件路径，相对于 android/ 目录
storeFile=petwise-release.jks

# 密钥库口令
storePassword=

# 密钥别名（生成时 -alias 的值）
keyAlias=petwise

# 该别名的口令（生成时若与库口令相同，填一样的值）
keyPassword=
